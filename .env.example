# Copy to .env and fill in. .env is ignored by Git; never commit real secrets.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5433/knowledge_assistant
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen3:8b
EMBED_MODEL=nomic-embed-text

# Signs login tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Optional
# ACCESS_TOKEN_MINUTES=60
# MAX_UPLOAD_MB=20
